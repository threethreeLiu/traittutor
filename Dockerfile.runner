FROM python:3.11-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential ca-certificates curl fonts-wqy-zenhei git jq ripgrep \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir \
        Pillow PyMuPDF defusedxml lxml numpy openpyxl pandas pdfplumber pypdf \
        python-docx python-pptx reportlab \
    && useradd --create-home --uid 1000 --shell /bin/bash runner

WORKDIR /app
COPY traittutor/services/sandbox/runner/server.py ./server.py
COPY LICENSE NOTICE THIRD_PARTY_NOTICES.md ./

ENV RUNNER_PORT=8900 PYTHONUNBUFFERED=1
EXPOSE 8900
USER runner
CMD ["python", "/app/server.py"]
