{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "types": [
      "node"
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-playwright-3100/types/**/*.ts",
    ".next-playwright-3100/dev/types/**/*.ts",
    ".next-playwright-3101/types/**/*.ts",
    ".next-playwright-3101/dev/types/**/*.ts",
    ".next-build-verify/types/**/*.ts",
    ".next-build-verify/dev/types/**/*.ts",
    ".next-manual/types/**/*.ts",
    ".next-manual/dev/types/**/*.ts",
    ".next-playwright-3110/types/**/*.ts",
    ".next-playwright-3110/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
