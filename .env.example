# ============================================
# TraitTutor Compose — host-side configuration
# ============================================
# Copy to .env and edit. `.env` is gitignored.
#
# All values are loopback bindings on the HOST side. The container-side
# ports come from the same Compose variables. This file controls host binding
# and the matching ports used by the backend and frontend processes.
#
# The API base URL the browser uses is NOT a compose env var. The
# entrypoint reads `TRAITTUTOR_API_BASE_URL` from
# data/user/settings/system.json on every start (preferring the
# in-network `next_public_api_base`, then the external override
# `next_public_api_base_external`, then `http://localhost:${BACKEND_PORT}`),
# and web/proxy.ts rewrites /api/* and /ws/* to it at request time.
# ============================================

# Host-side loopback bindings (override if 8001/3782 are taken)
TRAITTUTOR_DOCKER_BIND_HOST=127.0.0.1
TRAITTUTOR_DOCKER_BACKEND_PORT=8001
TRAITTUTOR_DOCKER_FRONTEND_PORT=3782

# Gateway-backed product paths used by the current Compose deployment.
TRAITTUTOR_RESEARCH_WORKSPACE_GATEWAY=1
TRAITTUTOR_RESEARCH_WORKSPACE_STREAM_GATEWAY=1
TRAITTUTOR_SESSION_TITLE_GATEWAY=1
TRAITTUTOR_NOTEBOOK_SUMMARY_GATEWAY=1

# Optional global calibration artifact. If unset/missing, canonical BKT stays
# honest cold-start (evidence count + wide interval, no posterior).
# Source/systemd example: /absolute/path/to/bkt-parameters.json
# Compose example: /app/data/system/config/bkt-parameters.json
# TRAITTUTOR_BKT_PARAMETERS_PATH=/absolute/path/to/bkt-parameters.json
